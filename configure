#!/bin/sh
# SPDX-FileCopyrightText: (C) 2026 Gavin John
# SPDX-License-Identifier: GPL-3.0-or-later
#
# configure for spicule -- same shape as musl's: probes a few things, writes
# config.mak, and leaves everything else to the Makefile.

usage () {
cat <<USAGE
Usage: $0 [OPTION]... [VAR=VALUE]...

  --srcdir=DIR            source directory [detected]
  --prefix=PREFIX         main installation prefix [/usr/local/spicule]
  --exec-prefix=EPREFIX   installation prefix for executable files [PREFIX]
  --bindir=DIR            user executables [EPREFIX/bin]
  --libdir=DIR            library files for the linker [PREFIX/lib]
  --includedir=DIR        include files for the C compiler [PREFIX/include]
  --syslibdir=DIR         unused, accepted for musl compatibility
  --host=HOST             the system spicule will RUN on: i386-win32,
                          x86_64-win32, aarch64-linux or x86_64-linux
                          [guess from CC]
  --target=TARGET         accepted as an alias of --host, for musl
                          compatibility.  Autoconf's --target means "what
                          the compiler in this package emits code for",
                          which is meaningless here: spicule is a library,
                          not a toolchain.  Cross-compiling spicule is the
                          normal case and --host is the knob for it.
  --platform=PLATFORM     which OS-level backend to build: nt [default] or
                          linux.  Independent of --host's ARCH (CPU width);
                          see Makefile's PLAT_GLOBS comment.
  --enable-debug          build with debugging information (-g)
  --disable-debug         build without debugging information [default]
  --enable-warnings       build with recommended warnings flags [default]
  --disable-warnings      build without warnings flags
  --enable-wrapper        build the spicule-tcc wrapper script [default]
  --disable-wrapper       do not build the wrapper script
  --enable-kernel32       allow the few places that have no pure-NTDLL way
                          to do something to fall back to kernel32
  --disable-kernel32      build with no kernel32 dependency at all;
                          the features that need it are compiled out
                          [default]

Some influential environment variables:
  CC                      C compiler command (a win32-targeting tcc)
  CFLAGS                  C compiler flags
  CROSS_COMPILE           prefix for cross compiler and tools (e.g. i386-win32-)
  AR                      archiver [CC -ar]
  WINE                    wine binary used by 'make check' [wine/wine64]

USAGE
exit 0
}

# Beginning of actual script

quote () {
tr '\n' ' ' <<EOQ | grep '^[-[:alnum:]_=,./:]* $' >/dev/null 2>&1 && { echo "$1" ; return 0 ; }
$1
EOQ
printf %s\\n "$1" | sed -e "s/'/'\\\\''/g" -e "1s/^/'/" -e "\$s/\$/'/" -e "s#^'\([-[:alnum:]_,./:]*\)=\(.*\)\$#\1='\2#"
}
echo () { printf "%s\n" "$*" ; }
fail () { echo "$*" ; exit 1 ; }
fnmatch () { eval "case \"\$2\" in $1) return 0 ;; *) return 1 ;; esac" ; }
cmdexists () { type "$1" >/dev/null 2>&1 ; }
trycc () { test -z "$CC" && cmdexists "$1" && CC=$1 ; }

stripdir () {
while eval "fnmatch '*/' \"\${$1}\"" ; do eval "$1=\${$1%/}" ; done
}

tryflag () {
printf "checking whether compiler accepts %s... " "$2"
echo "typedef int x;" > "$tmpc"
# CC and the flag lists must word-split; that is what they are.
# shellcheck disable=SC2086
if $CC $CFLAGS_TRY $2 -c -o /dev/null "$tmpc" >/dev/null 2>&1 ; then
printf "yes\n"
eval "$1=\"\${$1} \$2\""
eval "$1=\${$1# }"
return 0
else
printf "no\n"
return 1
fi
}

CFLAGS_C99FSE=
CFLAGS_AUTO=
CFLAGS_TRY=
srcdir=
prefix=/usr/local/spicule
# These four are literal make variable references, written verbatim into
# config.mak for make to expand; the shell must not expand them here.
# shellcheck disable=SC2016
exec_prefix='$(prefix)'
# shellcheck disable=SC2016
bindir='$(exec_prefix)/bin'
# shellcheck disable=SC2016
libdir='$(prefix)/lib'
# shellcheck disable=SC2016
includedir='$(prefix)/include'
target=
platform=nt
debug=no
warnings=yes
wrapper=yes
kernel32=no

for arg ; do
case "$arg" in
--help|-h) usage ;;
--srcdir=*) srcdir=${arg#*=} ;;
--prefix=*) prefix=${arg#*=} ;;
--exec-prefix=*) exec_prefix=${arg#*=} ;;
--bindir=*) bindir=${arg#*=} ;;
--libdir=*) libdir=${arg#*=} ;;
--includedir=*) includedir=${arg#*=} ;;
--syslibdir=*) ;;
--host=*|--target=*) target=${arg#*=} ;;
--platform=*) platform=${arg#*=} ;;
--build=*) ;;
--enable-debug|--enable-debug=yes) debug=yes ;;
--disable-debug|--enable-debug=no) debug=no ;;
--enable-warnings|--enable-warnings=yes) warnings=yes ;;
--disable-warnings|--enable-warnings=no) warnings=no ;;
--enable-wrapper|--enable-wrapper=yes) wrapper=yes ;;
--disable-wrapper|--enable-wrapper=no) wrapper=no ;;
--enable-kernel32|--enable-kernel32=yes) kernel32=yes ;;
--disable-kernel32|--enable-kernel32=no) kernel32=no ;;
--enable-*|--disable-*|--with-*|--without-*|--*) ;;
-* ) echo "$0: unknown option $arg" ;;
CC=*) CC=${arg#*=} ;;
CFLAGS=*) CFLAGS=${arg#*=} ;;
CPPFLAGS=*) CPPFLAGS=${arg#*=} ;;
LDFLAGS=*) LDFLAGS=${arg#*=} ;;
CROSS_COMPILE=*) CROSS_COMPILE=${arg#*=} ;;
AR=*) AR=${arg#*=} ;;
WINE=*) WINE=${arg#*=} ;;
*=*) ;;
*) ;;
esac
done

for i in srcdir prefix exec_prefix bindir libdir includedir ; do
stripdir $i
done

#
# Get the source dir for out-of-tree builds
#
if test -z "$srcdir" ; then
srcdir="${0%/configure}"
stripdir srcdir
fi
abs_builddir="$(pwd)" || fail "$0: cannot determine working directory"
abs_srcdir="$(cd "$srcdir" && pwd)" || fail "$0: invalid source directory $srcdir"
test "$abs_srcdir" = "$abs_builddir" && srcdir=.
test "$srcdir" != "." && test -f Makefile && test ! -h Makefile && fail "$0: Makefile already exists in the working directory"

#
# Get a temp filename we can use
#
i=0
set -C
while : ; do i=$((i+1))
tmpc="./conf$$-$PPID-$i.c"
# shellcheck disable=SC2188
2>|/dev/null > "$tmpc" && break
test "$i" -gt 50 && fail "$0: cannot create temporary file $tmpc"
done
set +C
trap 'rm "$tmpc"' EXIT QUIT TERM HUP
trap 'rm "$tmpc" ; exit 1' INT

#
# platform must be known before compiler discovery, which branches on it.
#
case "$platform" in
nt|linux) ;;
*) fail "$0: unsupported platform \"$platform\" (only \"nt\" and \"linux\" are implemented)" ;;
esac

#
# Find a C compiler to use.
#
# platform=nt: only tcc is known to work, but anything producing PE
# objects with the same calling conventions should.
#
# platform=linux: any native compiler that emits real ELF for the host
# -- gcc or clang, nothing win32-shaped about it.  This is the same
# native build tools/linux-build*.sh have used ad hoc all along (see
# their own banners); configure now knows about it directly rather than
# leaving it to a script's SPICULE_CC default.
#
printf "checking for C compiler... "
if [ "$platform" = linux ] ; then
trycc "${CROSS_COMPILE}cc"
trycc "${CROSS_COMPILE}clang"
trycc "${CROSS_COMPILE}gcc"
printf "%s\n" "$CC"
test -n "$CC" || { echo "$0: cannot find a native C compiler (try CC=clang)" ; exit 1 ; }
else
# A candidate must exist and must target Windows (define _WIN32); the
# native tcc on a Unix host does not, so it is skipped.
tryccwin () {
test -z "$CC" || return 0
cmdexists "$1" || return 1
cat > "$tmpc" <<'EOC'
#ifndef _WIN32
#error not windows
#endif
typedef int x;
EOC
# shellcheck disable=SC2086
"$1" $CPPFLAGS $CFLAGS -c -o /dev/null "$tmpc" >/dev/null 2>&1 && CC=$1
}
case "$target" in
i386*|i486*|i586*|i686*|x86) tryccwin "${CROSS_COMPILE}tcc" ; tryccwin i386-win32-tcc ; tryccwin i686-w64-mingw32-gcc ;;
x86_64*|amd64*) tryccwin "${CROSS_COMPILE}tcc" ; tryccwin x86_64-win32-tcc ; tryccwin x86_64-w64-mingw32-gcc ;;
esac
tryccwin "${CROSS_COMPILE}tcc"
tryccwin "${CROSS_COMPILE}cc"
tryccwin "${CROSS_COMPILE}gcc"
test -z "$target" && tryccwin i386-win32-tcc
test -z "$target" && tryccwin x86_64-win32-tcc
printf "%s\n" "$CC"
test -n "$CC" || { echo "$0: cannot find a C compiler targeting Windows (try CC=i386-win32-tcc)" ; exit 1 ; }
fi

printf "checking whether C compiler works... "
echo "typedef int x;" > "$tmpc"
# shellcheck disable=SC2086
if output=$($CC $CPPFLAGS $CFLAGS -c -o /dev/null "$tmpc" 2>&1) ; then
printf "yes\n"
else
printf "no; compiler output follows:\n%s\n" "$output"
exit 1
fi

#
# Figure out the target architecture from the compiler, unless told.
#
if test -z "$target" ; then
printf "checking target architecture... "
if [ "$platform" = linux ] ; then
# `#undef linux`: gcc/clang predefine `linux` as an object-like macro
# (equal to 1) in gnu* modes, and "aarch64-linux" below is three
# preprocessing tokens (linux is its own token, delimited by the
# hyphens) -- without the #undef the substitution turns the intended
# "aarch64-linux" output into "aarch64-1", silently naming the wrong
# target. Confirmed empirically, not theoretical.
cat > "$tmpc" <<'EOC'
#undef linux
#if defined(__aarch64__)
aarch64-linux
#elif defined(__x86_64__)
x86_64-linux
#elif defined(__i386__)
i386-linux
#else
unknown
#endif
EOC
else
cat > "$tmpc" <<'EOC'
#if defined(__x86_64__) || defined(_WIN64)
x86_64-win32
#elif defined(__i386__) || defined(_WIN32)
i386-win32
#else
unknown
#endif
EOC
fi
# shellcheck disable=SC2086
target=$($CC $CPPFLAGS -E "$tmpc" 2>/dev/null | grep -v '^#' | grep -v '^[[:space:]]*$' | tail -n1 | tr -d '[:space:]')
printf "%s\n" "$target"
fi

case "$target" in
i386*|i486*|i586*|i686*|x86) ARCH=i386 ;;
x86_64*|amd64*) ARCH=x86_64 ;;
aarch64*|arm64*) ARCH=aarch64 ;;
*) fail "$0: unknown or unsupported target \"$target\"" ;;
esac

if [ "$platform" = nt ] ; then
#
# The compiler must be targeting Windows/PE at all.
#
printf "checking whether compiler targets Windows... "
cat > "$tmpc" <<'EOC'
#ifndef _WIN32
#error not windows
#endif
typedef int x;
EOC
# shellcheck disable=SC2086
if $CC $CPPFLAGS $CFLAGS -c -o /dev/null "$tmpc" >/dev/null 2>&1 ; then
printf "yes\n"
else
printf "no\n"
fail "$0: $CC does not define _WIN32; a win32-targeting compiler is required"
fi
fi

#
# Archiver: tcc can act as one itself.
#
if test -z "$AR" ; then
printf "checking for archiver... "
if $CC -ar 2>&1 | grep -qi 'usage\|tcc' ; then
AR="$CC -ar"
elif cmdexists "${CROSS_COMPILE}ar" ; then
AR=${CROSS_COMPILE}ar
else
# A command name to put in config.mak, not the output of running ar.
# shellcheck disable=SC2209
AR=ar
fi
printf "%s\n" "$AR"
fi

#
# Wine, for 'make check' only -- meaningless for platform=linux, which
# runs its own binaries natively and has no `make check`/`linkcheck`
# equivalent wired up yet (see Makefile).
#
if [ "$platform" = nt ] && test -z "$WINE" ; then
case "$ARCH" in
x86_64) for w in wine64 /usr/lib/wine/wine64 wine ; do cmdexists "$w" && { WINE=$w ; break ; } ; done ;;
*) cmdexists wine && WINE=wine ;;
esac
fi

#
# -Wl,--delay-all: only a patched tinycc (not the stock TinyCC checked out
# by CI's build-toolchain job as of this writing) implements this; a
# stock tcc rejects it outright ("unsupported linker option '--delay-all'"
# -- confirmed against an unpatched build). test/delayall.c and its
# Makefile rules are gated on this, and skipped (not silently dropped --
# see tools/run-tests.py's NA result) when it is absent, so CI stays green
# until $CC is repointed at a toolchain that has the flag.
#
# The probe is a bare freestanding program with no imports at all
# (nothing here pulls in crt1.o/libc.a, on purpose): with zero delay
# imports tccpe.c's pe_build_delay_imports() never references
# __delayLoadHelper2, so this checks only whether the *flag* is
# recognised, not whether the whole delay-load runtime link-succeeds --
# that part is exercised for real by the actual test build.
#
if [ "$platform" = nt ] ; then
printf "checking whether linker accepts -Wl,--delay-all... "
echo "void _start(void) {}" > "$tmpc"
tmpexe="$tmpc.exe"
# shellcheck disable=SC2086
if $CC $CPPFLAGS $CFLAGS -Wl,--delay-all -nostdlib -o "$tmpexe" "$tmpc" >/dev/null 2>&1 ; then
printf "yes\n"
delay_all=yes
else
printf "no\n"
delay_all=no
fi
rm -f "$tmpexe"
else
delay_all=no
fi

#
# Flags.
#
tryflag CFLAGS_C99FSE -std=c99
tryflag CFLAGS_C99FSE -nostdinc
tryflag CFLAGS_C99FSE -fno-builtin

# Without this, clang/gcc on aarch64 emit calls to an outline-atomics
# runtime dispatcher (__aarch64_have_lse_atomics et al, resolved via
# libgcc's lse-init.o calling glibc's own getauxval()) for the plain
# __atomic_* builtins this tree's Linux backends use directly -- this
# -nostdlib build links against neither a hosted libgcc/compiler-rt nor
# glibc, so any test binary that actually links (not just compiles to
# a .a) fails with "undefined reference to `__getauxval'". Already
# diagnosed and fixed the identical way in tools/linux-build-crt.sh's
# own CFLAGS; tryflag's probe naturally no-ops this on a non-aarch64
# target or a compiler that does not recognize the flag (confirmed:
# platform=nt's tcc), so no platform/arch guard is needed here.
tryflag CFLAGS_C99FSE -mno-outline-atomics

# This tree has no __stack_chk_guard/__stack_chk_fail (tcc, the only NT
# compiler, never inserts stack-protector calls), but a native host cc
# (clang/gcc building for platform=linux) defaults to inserting them
# anyway, and the -nostdlib link fails on those two undefined symbols.
# Already diagnosed and fixed the identical way in
# tools/linux-build-crt.sh and tools/posix-opts.py's own CFLAGS;
# tcc accepts this flag as a no-op, so no platform guard is needed here.
tryflag CFLAGS_C99FSE -fno-stack-protector

if test "$debug" = yes ; then
CFLAGS_AUTO=-g
fi

if test "$warnings" = yes ; then
tryflag CFLAGS_AUTO -Wall
tryflag CFLAGS_AUTO -Wno-unused-function
fi

printf "creating config.mak... "

cmdline=$(quote "$0")
for i ; do cmdline="$cmdline $(quote "$i")" ; done

exec 3>&1 1>config.mak

cat << EOM
# This version of config.mak was generated by:
# $cmdline
# Any changes made here will be lost if configure is re-run
AR = $AR
ARCH = $ARCH
PLATFORM = $platform
srcdir = $srcdir
TARGET = $target
prefix = $prefix
exec_prefix = $exec_prefix
bindir = $bindir
libdir = $libdir
includedir = $includedir
CC = $CC
CFLAGS = $CFLAGS
CFLAGS_AUTO = $CFLAGS_AUTO
CFLAGS_C99FSE = $CFLAGS_C99FSE
CPPFLAGS = $CPPFLAGS
LDFLAGS = $LDFLAGS
CROSS_COMPILE = $CROSS_COMPILE
WINE = $WINE
WRAPPER = $wrapper
KERNEL32 = $kernel32
DELAY_ALL = $delay_all
EOM
exec 1>&3 3>&-

test "$srcdir" = "." || ln -sf "$srcdir/Makefile" .

#
# Enable the tracked pre-commit hook and the merge driver for the generated
# kaem build recipes.  Both settings are per-clone Git configuration, so
# configure installs them when it is run from a checkout.
#
if git -C "$abs_srcdir" rev-parse --git-dir >/dev/null 2>&1 ; then
git -C "$abs_srcdir" config core.hooksPath .githooks
git -C "$abs_srcdir" config merge.spicule-kaem.driver 'tools/merge-kaem.sh %O %A %B %P'
# Retire drivers installed by older revisions, under their old names: the
# generated-report driver, which no longer exists, and the kaem driver as it
# was spelled before the project was renamed from ntlibc to spicule.
git -C "$abs_srcdir" config --unset-all merge.ntlibc-gendata.driver 2>/dev/null || :
git -C "$abs_srcdir" config --unset-all merge.ntlibc-kaem.driver 2>/dev/null || :
fi

printf "done\n"
