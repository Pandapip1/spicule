TYPEDEF unsigned _Addr size_t;
TYPEDEF unsigned _Addr uintptr_t;
TYPEDEF _Addr ptrdiff_t;
TYPEDEF _Addr ssize_t;
TYPEDEF _Addr intptr_t;
TYPEDEF _Addr regoff_t;
TYPEDEF _Reg register_t;
TYPEDEF _Int64 time_t;
TYPEDEF _Int64 suseconds_t;

TYPEDEF signed char     int8_t;
TYPEDEF signed short    int16_t;
TYPEDEF signed int      int32_t;
TYPEDEF signed _Int64   int64_t;
TYPEDEF signed _Int64   intmax_t;
TYPEDEF unsigned char   uint8_t;
TYPEDEF unsigned short  uint16_t;
TYPEDEF unsigned int    uint32_t;
TYPEDEF unsigned _Int64 uint64_t;
TYPEDEF unsigned _Int64 u_int64_t;
TYPEDEF unsigned _Int64 uintmax_t;

TYPEDEF unsigned mode_t;
TYPEDEF unsigned _Reg nlink_t;
TYPEDEF _Int64 off_t;
TYPEDEF unsigned _Int64 ino_t;
TYPEDEF unsigned _Int64 dev_t;
TYPEDEF long blksize_t;
TYPEDEF _Int64 blkcnt_t;
TYPEDEF unsigned _Int64 fsblkcnt_t;
TYPEDEF unsigned _Int64 fsfilcnt_t;

TYPEDEF unsigned wctype_t;

TYPEDEF void * timer_t;
TYPEDEF int clockid_t;
TYPEDEF _Int64 clock_t;
STRUCT timeval { time_t tv_sec; suseconds_t tv_usec; };
STRUCT timespec { time_t tv_sec; long tv_nsec; };

/* <time.h>'s BSD/GNU spelling of struct tm's two reserved-namespace
 * members.  These #defines have to precede the struct definition, and
 * therefore have to live wherever the struct does: while struct tm was
 * defined in time.h below them they worked by position, and moving the
 * struct here without them would have silently produced a struct with
 * __tm_gmtoff/__tm_zone members in any translation unit that reached
 * the struct through a header other than <time.h> -- two incompatible
 * layouts of the same type, which is the exact ODR trap the shared
 * definition exists to prevent.  (src/time/gmtime.c and localtime.c
 * caught this immediately when it was got wrong.) */
#if defined(_BSD_SOURCE) || defined(_GNU_SOURCE)
#define __tm_gmtoff tm_gmtoff
#define __tm_zone tm_zone
#endif

/* struct tm lived in <time.h> alone until <wchar.h> needed it too:
 * wchar.h.html requires <wchar.h> to declare struct tm as a COMPLETE
 * type (for wcsftime()), not merely to forward-declare it, so a caller
 * may write `struct tm tm;` having included only <wchar.h>.  Sharing it
 * through the __NEED_/__DEFINED_ mechanism is how this tree already
 * handles a type two headers must agree on; a second definition in
 * wchar.h would be a silent ODR trap the first time either one gained
 * a field.  The __tm_gmtoff/__tm_zone members are the reserved-namespace
 * extensions strftime()'s %z/%Z read (src/time/strftime.c). */
STRUCT tm { int tm_sec; int tm_min; int tm_hour; int tm_mday; int tm_mon; int tm_year; int tm_wday; int tm_yday; int tm_isdst; long __tm_gmtoff; const char *__tm_zone; };

/* POSIX puts struct sched_param in <sched.h>; spicule's <sched.h>
 * deliberately declares nothing from the _POSIX_PRIORITY_SCHEDULING
 * option group, so the only header that defines it today is <spawn.h>,
 * whose posix_spawnattr_getschedparam()/_setschedparam() take one.  It
 * lives here rather than in spawn.h so that <sched.h> can start
 * defining it -- through the same __NEED_struct_sched_param guard --
 * the day that option group is claimed, without a redefinition.
 * sched_priority is the only member POSIX requires. */
STRUCT sched_param { int sched_priority; };

TYPEDEF int pid_t;
TYPEDEF unsigned id_t;
TYPEDEF unsigned uid_t;
TYPEDEF unsigned gid_t;
TYPEDEF int key_t;
TYPEDEF unsigned useconds_t;

TYPEDEF struct __locale_struct * locale_t;

/* nl_types.h.html: "nl_item  Used by nl_langinfo() to identify items of
 * langinfo data."  <langinfo.h> must define the same type ("shall define
 * the nl_item type as described in <nl_types.h>"), so it lives here
 * rather than in either header, and neither one can drift from the
 * other.  int, because every value <langinfo.h> gives it is a small
 * non-negative constant and the invalid-item probe a caller is entitled
 * to make -- nl_langinfo((nl_item)-1) -- has to be representable.
 *
 * nl_catd is "[u]sed by the message catalog functions catopen(),
 * catgets(), and catclose() to identify a catalog descriptor"; POSIX
 * fixes nothing about its representation except that (nl_catd)-1 is a
 * distinguishable failure value, which a pointer type supplies. */
TYPEDEF int nl_item;
TYPEDEF void * nl_catd;

TYPEDEF unsigned socklen_t;
TYPEDEF unsigned short sa_family_t;

TYPEDEF struct _IO_FILE FILE;

TYPEDEF __builtin_va_list va_list;
TYPEDEF __builtin_va_list __isoc_va_list;

TYPEDEF struct __mbstate_t { unsigned __opaque1, __opaque2; } mbstate_t;

TYPEDEF struct __sigset_t { unsigned long __bits[128/sizeof(long)]; } sigset_t;

TYPEDEF int sig_atomic_t;

/* pthread_t is an implementation-owned control-block pointer.  Keeping the
 * identity opaque lets joined and detached threads retain a tombstone long
 * enough for the required ESRCH/EINVAL diagnostics without exposing an NT
 * HANDLE as part of the public ABI.  pthread_attr_t is deliberately opaque
 * too; twelve pointer-width slots leave room for the POSIX creation
 * attributes on both supported architectures. */
TYPEDEF struct __pthread * pthread_t;
TYPEDEF struct { void *__opaque[12]; } pthread_attr_t;

// NOLINTEND(bugprone-reserved-identifier,cert-dcl37-c,cert-dcl51-cpp)
